# -----------------------------
# Node.js / Expo (Frontend)
# -----------------------------
frontend/node_modules/
frontend/.expo/
frontend/.env
frontend/*.log
frontend/npm-debug.log*
frontend/yarn-error.log*

# -----------------------------
# Python / FastAPI (Backend)
# -----------------------------
backend/venv/
backend/__pycache__/
backend/*.pyc
backend/*.pyo
backend/*.pyd
backend/.env
backend/users.db           # SQLite database
backend/*.log
backend/alembic/versions/  # optional: ignore migrations if you want (or keep if you want versioned migrations)

# -----------------------------
# General
# -----------------------------
.DS_Store
*.swp
*.swo
