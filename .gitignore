# Node.js/Expo (Frontend)
   frontend/node_modules/
   frontend/.expo/
   frontend/.env
   frontend/*.log
   frontend/npm-debug.log*
   frontend/yarn-error.log*

   # Python/FastAPI (Backend)
   backend/venv/
   backend/__pycache__/
   backend/*.pyc
   backend/*.pyo
   backend/*.pyd
   backend/.env
   backend/users.db  # SQLite database file
   backend/*.log

   # General
   .DS_Store
   *.swp
   *.swo